<!DOCTYPE html>
<html lang="th" data-theme="dark">
<head>
<meta charset="UTF-8">
<base target="_top">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>
:root{--bg:#0b1020;--bg2:#0f1630;--card:rgba(255,255,255,.055);--stroke:rgba(255,255,255,.10);
--txt:#eaf0ff;--muted:#93a0c4;--in:#22d3a6;--ex:#ff6b81;--acc:#7c8cff;--acc2:#b06bff;--shadow:0 18px 40px rgba(0,0,0,.45)}
[data-theme="light"]{--bg:#eef2fb;--bg2:#fff;--card:rgba(255,255,255,.88);--stroke:rgba(16,24,48,.10);
--txt:#15203c;--muted:#5f6c8d;--shadow:0 14px 34px rgba(30,45,90,.12)}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'IBM Plex Sans Thai',system-ui,sans-serif;background:var(--bg);color:var(--txt);min-height:100vh;padding:20px;
background-image:radial-gradient(900px 500px at 12% -8%,rgba(124,140,255,.22),transparent 60%),
radial-gradient(800px 500px at 92% 0%,rgba(176,107,255,.18),transparent 60%),
radial-gradient(700px 500px at 50% 110%,rgba(34,211,166,.14),transparent 60%)}
.wrap{max-width:100%;margin:0 auto}
.glass{background:var(--card);border:1px solid var(--stroke);border-radius:20px;box-shadow:var(--shadow);backdrop-filter:blur(14px)}
/* AUTH */
.authwrap{min-height:88vh;display:grid;place-items:center}
.authcard{width:100%;max-width:420px;padding:34px 30px}
.authlogo{width:58px;height:58px;border-radius:17px;margin:0 auto 14px;background:linear-gradient(135deg,var(--acc),var(--acc2));
display:grid;place-items:center;font-size:28px;box-shadow:0 10px 26px rgba(124,140,255,.45)}
.authcard h2{text-align:center;font-size:21px;margin-bottom:5px}
.authcard .p{text-align:center;font-size:13px;color:var(--muted);margin-bottom:22px}
.atabs{display:flex;background:rgba(124,140,255,.10);border-radius:13px;padding:5px;gap:4px;margin-bottom:20px}
.atabs button{flex:1;padding:9px;border:none;border-radius:9px;background:transparent;cursor:pointer;font-weight:600;color:var(--muted);font-family:inherit;font-size:14px}
.atabs button.active{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff}
.msg{padding:10px 13px;border-radius:11px;font-size:13px;margin-bottom:14px;display:none}
.msg.err{display:block;background:rgba(255,107,129,.14);color:var(--ex);border:1px solid rgba(255,107,129,.3)}
.msg.ok{display:block;background:rgba(34,211,166,.14);color:var(--in);border:1px solid rgba(34,211,166,.3)}
button,select,input{font-family:inherit;font-size:14px;color:var(--txt)}
.fld{margin-bottom:14px}
.fld label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:500}
.fld input,.fld select{width:100%;padding:11px 13px;border-radius:12px;border:1px solid var(--stroke);background:var(--bg2);outline:none;transition:.18s}
.fld input:focus,.fld select:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(124,140,255,.18)}
.btn{padding:9px 15px;border-radius:11px;border:1px solid var(--stroke);background:transparent;cursor:pointer;transition:.18s;font-weight:500}
.btn:hover{background:rgba(124,140,255,.16);transform:translateY(-1px)}
.btn.primary{background:linear-gradient(135deg,var(--acc),var(--acc2));border:none;color:#fff;font-weight:600;box-shadow:0 8px 20px rgba(124,140,255,.35)}
.btn.block{width:100%;padding:12px}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none}
/* HEADER */
header{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;padding:16px 22px;margin-bottom:18px;position:relative;z-index:50}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:44px;height:44px;border-radius:13px;background:linear-gradient(135deg,var(--acc),var(--acc2));display:grid;place-items:center;font-size:22px}
h1{font-size:18px;font-weight:700}
.sub{font-size:12.5px;color:var(--muted)}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;position:relative}
.avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--in),var(--acc));display:grid;place-items:center;font-weight:700;font-size:14px;color:#04241c}
.periodbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding:14px 18px;margin-bottom:18px}
.tabs{display:flex;background:rgba(124,140,255,.10);border-radius:13px;padding:5px;gap:4px}
.tab{padding:8px 20px;border-radius:9px;border:none;background:transparent;cursor:pointer;font-weight:600;color:var(--muted);transition:.18s}
.tab.active{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff}
.pickers input,.pickers select{padding:9px 12px;border-radius:11px;border:1px solid var(--stroke);background:var(--bg2);outline:none}
.rangetxt{font-size:13px;color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:18px}
.kpi{padding:18px 20px;position:relative;overflow:hidden}
.kpi::after{content:"";position:absolute;inset:auto auto -40px -30px;width:120px;height:120px;border-radius:50%;background:var(--glow);filter:blur(28px);opacity:.5}
.kpi .lb{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:7px;margin-bottom:8px}
.kpi .vl{font-size:26px;font-weight:700;letter-spacing:-.4px}
.kpi .ft{font-size:12px;color:var(--muted);margin-top:6px}
.dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.grid2{display:grid;grid-template-columns:1.55fr 1fr;gap:16px;margin-bottom:18px}
.grid3{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px}
.panel{padding:18px 20px}
.panel h3{font-size:15px;font-weight:600;margin-bottom:4px}
.panel .desc{font-size:12px;color:var(--muted);margin-bottom:14px}
.chartbox{position:relative;height:290px}.chartbox.sm{height:235px}
.ybar .row{display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px}
.track{height:12px;border-radius:99px;background:rgba(147,160,196,.18);overflow:hidden;margin-bottom:16px}
.fill{height:100%;border-radius:99px;transition:width .6s cubic-bezier(.4,0,.2,1)}
.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end}
.formgrid .fld{margin-bottom:0}
.seg{display:flex;gap:6px;background:rgba(124,140,255,.10);padding:5px;border-radius:12px}
.seg button{flex:1;padding:8px;border:none;border-radius:8px;background:transparent;cursor:pointer;font-weight:600;color:var(--muted)}
.seg button.on-in{background:var(--in);color:#04241c}
.seg button.on-ex{background:var(--ex);color:#3d0a13}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-size:12px;color:var(--muted);font-weight:600;padding:10px 12px;border-bottom:1px solid var(--stroke);white-space:nowrap}
td{padding:11px 12px;border-bottom:1px solid var(--stroke)}
tbody tr:hover{background:rgba(124,140,255,.07)}
.pill{padding:3px 10px;border-radius:99px;font-size:11.5px;font-weight:600}
.pill.in{background:rgba(34,211,166,.16);color:var(--in)}
.pill.ex{background:rgba(255,107,129,.16);color:var(--ex)}
.amt{text-align:right;font-weight:600;white-space:nowrap}
.ic{width:30px;height:30px;border-radius:9px;border:1px solid var(--stroke);background:transparent;cursor:pointer;font-size:13px}
.ic:hover{background:rgba(124,140,255,.18)}
.empty{text-align:center;padding:46px;color:var(--muted);font-size:14px}
.toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(140px);background:linear-gradient(135deg,var(--acc),var(--acc2));
color:#fff;padding:12px 22px;border-radius:13px;font-weight:600;font-size:14px;transition:.35s;z-index:9999;max-width:90vw;text-align:center}
.toast.show{transform:translateX(-50%) translateY(0)}
.toast.bad{background:linear-gradient(135deg,#ff6b81,#ff9f7f)}
.loader{position:fixed;inset:0;background:rgba(6,10,24,.66);display:none;place-items:center;z-index:9998;backdrop-filter:blur(3px)}
.loader.on{display:grid}
.spin{width:44px;height:44px;border:4px solid rgba(255,255,255,.2);border-top-color:var(--acc);border-radius:50%;animation:sp .8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
@media(max-width:980px){.grid2,.grid3{grid-template-columns:1fr}}

/* MODAL STYLE & FIXED DROPDOWN */
.modal-overlay {position:fixed;inset:0;background:rgba(6,10,24,.8);display:none;place-items:center;z-index:999;backdrop-filter:blur(4px)}
.modal-overlay.on{display:grid}
.modal-card{width:100%;max-width:420px;padding:24px;background:var(--bg2);border:1px solid var(--stroke);border-radius:20px;box-shadow:var(--shadow)}

.dropdown { position: relative; display: inline-block; }
.dropdown-content { display: none; position: absolute; right: 0; top: 100%; background-color: var(--bg2); min-width: 160px; box-shadow: 0 10px 30px rgba(0,0,0,0.6); border: 1px solid var(--stroke); border-radius: 12px; z-index: 99999; overflow: hidden; margin-top: 6px; }
.dropdown-content button { width: 100%; text-align: left; padding: 12px 16px; background: none; border: none; color: var(--txt); cursor: pointer; font-size: 14px; font-family: inherit; display: block; white-space: nowrap; }
.dropdown-content button:hover { background: rgba(124,140,255,.2); }
.dropdown.show .dropdown-content { display: block; }
</style>
</head>
<body id="pdfContentArea">

<!-- ============ LOGIN ============ -->
<div class="wrap authwrap" id="authView">
  <div class="authcard glass">
    <div class="authlogo">₿</div>
    <h2>FinTrack Cloud</h2>
    <div class="p">ระบบบันทึกรายรับรายจ่าย · ข้อมูลเก็บบบน Google Sheets</div>
    <div class="atabs">
      <button id="tabLogin" class="active">เข้าสู่ระบบ</button>
      <button id="tabReg">สมัครสมาชิก</button>
    </div>
    <div class="msg" id="authMsg"></div>

    <form id="loginForm">
      <div class="fld"><label>ชื่อผู้ใช้</label><input type="text" id="lUser" autocomplete="username" required></div>
      <div class="fld"><label>รหัสผ่าน</label><input type="password" id="lPass" autocomplete="current-password" required></div>
      <button class="btn primary block" type="submit">เข้าสู่ระบบ</button>
    </form>

    <form id="regForm" hidden>
      <div class="fld"><label>ชื่อที่แสดง</label><input type="text" id="rName" placeholder="เช่น สมชาย ใจดี" required></div>
      <div class="fld"><label>ชื่อผู้ใช้ (a-z 0-9 . _ -)</label><input type="text" id="rUser" placeholder="อย่างน้อย 4 ตัวอักษร" required></div>
      <div class="fld"><label>รหัสผ่าน</label><input type="password" id="rPass" placeholder="อย่างน้อย 6 ตัวอักษร" required></div>
      <div class="fld"><label>ยืนยันรหัสผ่าน</label><input type="password" id="rPass2" required></div>
      <button class="btn primary block" type="submit">สร้างบัญชี</button>
    </form>
  </div>
</div>

<!-- ============ APP ============ -->
<div class="wrap" id="appView" hidden>
  <header class="glass">
    <div class="brand">
      <div class="logo">₿</div>
      <div><h1>FinTrack Cloud</h1><div class="sub" id="todayTxt"></div></div>
    </div>
    <div class="tools">
      <div class="avatar" id="avatar">?</div>
      <span class="sub" id="userTxt"></span>
      <button class="btn" id="themeBtn">🌙</button>
      <button class="btn" id="estBtn">📅 ประมาณการ</button>
      <button class="btn" id="syncBtn">🔄 ซิงก์</button>
      
      <!-- เมนูดาวน์โหลดเลือกรูปแบบ -->
      <div class="dropdown" id="downloadDropdown">
        <button class="btn" id="downloadMenuBtn" type="button">⬇ ดาวน์โหลด ▾</button>
        <div class="dropdown-content">
          <button type="button" onclick="openDownloadModal('excel')">📁 ไฟล์ Excel</button>
          <button type="button" onclick="openDownloadModal('pdf')">📄 ไฟล์ PDF</button>
        </div>
      </div>

      <button class="btn" id="pwBtn">🔑 รหัสผ่าน</button>
      <button class="btn" id="outBtn">ออกจากระบบ</button>
    </div>
  </header>

  <!-- MAIN DASHBOARD CONTAINER -->
  <div id="mainDashboardArea">
    <div class="periodbar glass">
      <div class="tabs">
        <button class="tab active" data-mode="week">รายสัปดาห์</button>
        <button class="tab" data-mode="month">รายเดือน</button>
        <button class="tab" data-mode="year">รายปี</button>
      </div>
      <div class="pickers">
        <input type="week" id="pWeek"><input type="month" id="pMonth" hidden><select id="pYear" hidden></select>
      </div>
      <div class="rangetxt" id="rangeTxt"></div>
    </div>

    <div class="kpis">
      <div class="kpi glass" style="--glow:var(--in)"><div class="lb"><span class="dot" style="background:var(--in)"></span> รายรับ</div>
        <div class="vl" id="kIn" style="color:var(--in)">฿0.00</div><div class="ft" id="kInF">0 รายการ</div></div>
      <div class="kpi glass" style="--glow:var(--ex)"><div class="lb"><span class="dot" style="background:var(--ex)"></span> รายจ่าย</div>
        <div class="vl" id="kEx" style="color:var(--ex)">฿0.00</div><div class="ft" id="kExF">0 รายการ</div></div>
      <div class="kpi glass" style="--glow:var(--acc)"><div class="lb"><span class="dot" style="background:var(--acc)"></span> คงเหลือสุทธิ</div>
        <div class="vl" id="kNet">฿0.00</div><div class="ft" id="kNetF">รายรับ − รายจ่าย</div></div>
      <div class="kpi glass" style="--glow:var(--acc2)"><div class="lb"><span class="dot" style="background:var(--acc2)"></span> อัตราการเก็บออม</div>
        <div class="vl" id="kRate">0%</div><div class="ft">ของรายรับทั้งหมด</div></div>
    </div>

    <div class="grid2">
      <div class="panel glass">
        <h3 id="cmpTitle">เปรียบเทียบรายรับ–รายจ่าย</h3>
        <div class="desc">แท่ง = รายรับ/รายจ่าย · เส้น = ยอดคงเหลือสะสม</div>
        <div class="chartbox"><canvas id="chMain"></canvas></div>
      </div>
      <div class="panel glass">
        <h3>สรุปทั้งปี <span id="yLabel"></span></h3><div class="desc">ภาพรวมรายรับเทียบรายจ่ายตลอดทั้งปี</div>
        <div class="ybar">
          <div class="row"><span>รายรับรวม</span><b id="yIn" style="color:var(--in)">฿0</b></div>
          <div class="track"><div class="fill" id="yInBar" style="width:0%;background:linear-gradient(90deg,#22d3a6,#5eead4)"></div></div>
          <div class="row"><span>รายจ่ายรวม</span><b id="yEx" style="color:var(--ex)">฿0</b></div>
          <div class="track"><div class="fill" id="yExBar" style="width:0%;background:linear-gradient(90deg,#ff6b81,#ffa7b4)"></div></div>
          <div class="row"><span>คงเหลือทั้งปี</span><b id="yNet">฿0</b></div>
          <div class="track"><div class="fill" id="yNetBar" style="width:0%;background:linear-gradient(90deg,#7c8cff,#b06bff)"></div></div>
        </div>
        <div class="chartbox" style="height:190px"><canvas id="chYear"></canvas></div>
      </div>
    </div>

    <div class="grid3">
      <div class="panel glass"><h3>รายจ่ายแยกตามหมวด</h3><div class="desc">ช่วงเวลาที่เลือก</div>
        <div class="chartbox sm"><canvas id="chExCat"></canvas></div></div>
      <div class="panel glass"><h3>รายรับแยกตามแหล่งที่มา</h3><div class="desc">ช่วงเวลาที่เลือก</div>
        <div class="chartbox sm"><canvas id="chInCat"></canvas></div></div>
    </div>

    <div class="panel glass" style="margin-bottom:18px">
      <h3 id="formTitle">➕ เพิ่มรายการใหม่</h3>
      <div class="desc">บันทึกลง Google Sheets ทันที · กดจัดการหมวดหมู่เพื่อเพิ่มหรือลบหมวด</div>
      <form id="txForm">
        <input type="hidden" id="fId">
        <div class="formgrid">
          <div class="fld"><label>ประเภท</label>
            <div class="seg"><button type="button" id="bIn" class="on-in">รายรับ</button><button type="button" id="bEx">รายจ่าย</button></div></div>
          <div class="fld"><label>วันที่</label><input type="date" id="fDate" required></div>
          <div class="fld"><label>หมวดหมู่</label>
            <div style="display:flex;gap:6px"><select id="fCat" required></select>
            <button type="button" class="btn" id="manageCatBtn" title="จัดการหมวดหมู่" style="padding:11px 13px">⚙️</button></div></div>
          <div class="fld"><label>รายละเอียด</label><input type="text" id="fNote" placeholder="เช่น ค่าอาหารกลางวัน"></div>
          <div class="fld"><label>จำนวนเงิน (บาท)</label><input type="number" id="fAmt" step="0.01" min="0" placeholder="0.00" required></div>
          <div class="fld" style="display:flex;gap:8px">
            <button type="submit" class="btn primary" style="flex:1" id="saveBtn">บันทึก</button>
            <button type="button" class="btn" id="cancelEdit" hidden>ยกเลิก</button></div>
        </div>
      </form>
    </div>

    <div class="panel glass">
      <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3>รายการทั้งหมด <span id="cnt" class="desc"></span></h3>
        <div style="display:flex;gap:8px">
          <input type="text" id="q" placeholder="🔍 ค้นหา..." style="padding:9px 13px;border-radius:11px;border:1px solid var(--stroke);background:var(--bg2);outline:none">
          <select id="fType" style="padding:9px 13px;border-radius:11px;border:1px solid var(--stroke);background:var(--bg2)">
            <option value="all">ทุกประเภท</option><option value="income">เฉพาะรายรับ</option><option value="expense">เฉพาะรายจ่าย</option></select>
        </div>
      </div>
      <div class="tablewrap"><table>
        <thead><tr><th>วันที่</th><th>ประเภท</th><th>หมวดหมู่</th><th>รายละเอียด</th><th style="text-align:right">จำนวนเงิน</th><th></th></tr></thead>
        <tbody id="tbody"></tbody></table></div>
      <div class="empty" id="emptyBox" hidden>ยังไม่มีรายการในช่วงเวลานี้ — เริ่มบันทึกรายการแรกได้เลย</div>
    </div>
  </div>

  <!-- ESTIMATE CALENDAR AREA -->
  <div id="estArea" hidden class="space-y-6">
    <div class="panel glass" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;padding:20px 24px;">
      <div>
        <h3 style="font-size:18px">📅 ปฏิทินประมาณการรายรับ – รายจ่ายประจำเดือน</h3>
        <div class="desc" style="margin-bottom:0">วางแผนตัวเลขล่วงหน้า แยกอิสระ คำนวณสรุปเฉพาะเดือนนั้นๆ</div>
      </div>
      <div style="display:flex;gap:10px;align-items:center;">
        <input type="month" id="estMonthPicker" style="padding:9px 12px;border-radius:11px;border:1px solid var(--stroke);background:var(--bg2);outline:none" onchange="renderEstimateCalendar()">
      </div>
    </div>

    <div class="kpis">
      <div class="kpi glass" style="--glow:var(--in)"><div class="lb"><span class="dot" style="background:var(--in)"></span> ประมาณการรายรับ</div>
        <div class="vl" id="estTotalIn" style="color:var(--in)">฿0.00</div></div>
      <div class="kpi glass" style="--glow:var(--ex)"><div class="lb"><span class="dot" style="background:var(--ex)"></span> ประมาณการรายจ่าย</div>
        <div class="vl" id="estTotalEx" style="color:var(--ex)">฿0.00</div></div>
      <div class="kpi glass" style="--glow:var(--acc)"><div class="lb"><span class="dot" style="background:var(--acc)"></span> ประมาณการคงเหลือ</div>
        <div class="vl" id="estNet">฿0.00</div></div>
    </div>

    <div class="panel glass" style="padding:24px;">
      <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:10px;text-align:center;margin-bottom:12px;font-size:13px;font-weight:600;color:var(--muted)">
