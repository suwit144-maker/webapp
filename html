<div class="loader" id="loader"><div class="spin"></div></div>
<div class="toast" id="toast"></div>

<script>
/* ============ API BRIDGE ============ */
let TOKEN = '';
try{ TOKEN = localStorage.getItem('ftc_token') || ''; }catch(e){}
const store = (k,v)=>{ try{ v===null?localStorage.removeItem(k):localStorage.setItem(k,v); }catch(e){} };

const call = (action, payload={}) => new Promise((res, rej)=>{
  google.script.run
    .withSuccessHandler(r => r && r.ok ? res(r.data) : rej(new Error(r ? r.error : 'ไม่มีการตอบกลับ')))
    .withFailureHandler(e => rej(new Error(e.message || 'เชื่อมต่อเซิร์ฟเวอร์ไม่สำเร็จ')))
    .api(action, payload, TOKEN);
});
const busy = on => document.getElementById('loader').classList.toggle('on', on);
const toast = (m, bad) => { const t=document.getElementById('toast');
  t.textContent=m; t.className='toast show'+(bad?' bad':''); setTimeout(()=>t.className='toast'+(bad?' bad':''),2600); };

/* ============ STATE ============ */
let TX=[], CATS={income:[],expense:[]}, ME=null, MODE='week', TYPE='income', EDIT=null;
let ESTIMATES = JSON.parse(localStorage.getItem('ftc_estimates') || '{}');
let modalType = 'income', catModalType = 'income';

/* ============ HELPERS ============ */
const pad=n=>String(n).padStart(2,'0');
const fmt=n=>'฿'+n.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});
const fmtS=n=>'฿'+n.toLocaleString('th-TH',{maximumFractionDigits:0});
const parseD=s=>{const[a,b,c]=s.split('-').map(Number);return new Date(a,b-1,c);};
const toStr=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const TH_M=['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
const thDate=d=>d.getDate()+' '+TH_M[d.getMonth()]+' '+(d.getFullYear()+543);
function isoWeek(dt){const d=new Date(dt.getFullYear(),dt.getMonth(),dt.getDate());d.setDate(d.getDate()-((d.getDay()+6)%7)+3);
  const t=new Date(d.getFullYear(),0,4);t.setDate(t.getDate()-((t.getDay()+6)%7)+3);
  return{year:d.getFullYear(),week:1+Math.round((d-t)/6048e5)};}
function weekRange(y,w){const t=new Date(y,0,4);const m=new Date(t);m.setDate(t.getDate()-((t.getDay()+6)%7));
  const s=new Date(m);s.setDate(m.getDate()+(w-1)*7);const e=new Date(s);e.setDate(s.getDate()+6);return[s,e];}
const css=v=>getComputedStyle(document.body).getPropertyValue(v).trim();
const gridC=()=>document.documentElement.dataset.theme==='dark'?'rgba(255,255,255,.07)':'rgba(20,30,60,.08)';

/* ============ AUTH UI ============ */
const authMsg=(m,ok)=>{const e=document.getElementById('authMsg');e.textContent=m;e.className='msg '+(ok?'ok':'err');};
document.getElementById('tabLogin').onclick=()=>{
  document.getElementById('tabLogin').classList.add('active');document.getElementById('tabReg').classList.remove('active');
  document.getElementById('loginForm').hidden=false;document.getElementById('regForm').hidden=true;document.getElementById('authMsg').className='msg';};
document.getElementById('tabReg').onclick=()=>{
  document.getElementById('tabReg').classList.add('active');document.getElementById('tabLogin').classList.remove('active');
  document.getElementById('regForm').hidden=false;document.getElementById('loginForm').hidden=true;document.getElementById('authMsg').className='msg';};

document.getElementById('loginForm').onsubmit = async e => {
  e.preventDefault(); 
  busy(true);
  try { 
    const d = await call('login', { username: document.getElementById('lUser').value, password: document.getElementById('lPass').value });
    TOKEN = d.token; store('ftc_token', TOKEN); 
    document.getElementById('authView').style.display = 'none';
    document.getElementById('appView').hidden = false;
    await enterApp();
  } catch (err) { authMsg(err.message); } finally { busy(false); }
};

document.getElementById('regForm').onsubmit = async e => {
  e.preventDefault();
  if (document.getElementById('rPass').value !== document.getElementById('rPass2').value) return authMsg('รหัสผ่านทั้งสองช่องไม่ตรงกัน');
  busy(true);
  try { 
    const d = await call('register', { username: document.getElementById('rUser').value, password: document.getElementById('rPass').value, displayName: document.getElementById('rName').value });
    TOKEN = d.token; store('ftc_token', TOKEN); 
    document.getElementById('authView').style.display = 'none';
    document.getElementById('appView').hidden = false;
    await enterApp();
  } catch (err) { authMsg(err.message); } finally { busy(false); }
};

document.getElementById('outBtn').onclick=async()=>{
  toast('ออกจากระบบเรียบร้อย');
  TOKEN='';store('ftc_token',null);setTimeout(()=>location.reload(),800);
};

document.getElementById('pwBtn').onclick=async()=>{
  const o=prompt('รหัสผ่านเดิม:');if(!o)return;const n=prompt('รหัสผ่านใหม่ (อย่างน้อย 6 ตัว):');if(!n)return;
  busy(true);try{await call('changePassword',{oldPassword:o,newPassword:n});toast('เปลี่ยนรหัสผ่านสำเร็จ ✓');}
  catch(e){toast(e.message,true);}finally{busy(false);}};

/* ============ DOWNLOAD DROPDOWN & MODAL LOGIC ============ */
const dropdownBtn = document.getElementById('downloadMenuBtn');
const dropdownContainer = document.getElementById('downloadDropdown');
dropdownBtn.onclick = (e) => {
  e.stopPropagation();
  dropdownContainer.classList.toggle('show');
};
window.onclick = () => {
  if (dropdownContainer.classList.contains('show')) {
    dropdownContainer.classList.remove('show');
  }
};

function openDownloadModal(type) {
  dropdownContainer.classList.remove('show');
  if(!TX.length) return toast('ยังไม่มีข้อมูลสำหรับดาวน์โหลด', true);
  
  document.getElementById('dlFileType').value = type;
  document.getElementById('dlModalTitle').textContent = type === 'excel' ? '📥 ดาวน์โหลดไฟล์ Excel' : '📥 ดาวน์โหลดไฟล์ PDF';
  
  // ตั้งค่าเริ่มต้นเป็นเดือนปัจจุบัน
  const now = new Date();
  const curYM = now.getFullYear() + '-' + pad(now.getMonth() + 1);
  document.getElementById('dlStartMonth').value = curYM;
  document.getElementById('dlEndMonth').value = curYM;
  
  document.getElementById('downloadModal').classList.add('on');
}

function closeDownloadModal() {
  document.getElementById('downloadModal').classList.remove('on');
}

function executeDownload() {
  const type = document.getElementById('dlFileType').value;
  const startYM = document.getElementById('dlStartMonth').value;
  const endYM = document.getElementById('dlEndMonth').value;
  
  if(!startYM || !endYM) return toast('กรุณาระบุช่วงเดือนให้ครบถ้วน', true);
  if(startYM > endYM) return toast('เดือนเริ่มต้นต้องมาก่อนเดือนสิ้นสุด', true);
  
  closeDownloadModal();
  
  // กรองข้อมูลตามช่วงปี-เดือนที่เลือก (YYYY-MM)
  const filtered = TX.filter(t => {
    const ym = t.date.slice(0, 7);
    return ym >= startYM && ym <= endYM;
  }).sort((a,b)=>a.date.localeCompare(b.date));
  
  if(!filtered.length) return toast('ไม่พบข้อมูลในช่วงเวลาที่เลือก', true);
  
  if(type === 'excel') {
    const rows = [['วันที่', 'ประเภท', 'หมวดหมู่', 'รายละเอียด', 'จำนวนเงิน']].concat(
      filtered.map(t => [t.date, t.type==='income'?'รายรับ':'รายจ่าย', t.category, t.note||'', t.amount])
    );
    let csvContent = '\uFEFF' + rows.map(e => e.map(v => '"' + String(v).replace(/"/g, '""') + '"').join(',')).join('\n');
    let blob = new Blob([csvContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
    let url = URL.createObjectURL(blob);
    let a = document.createElement('a');
    a.href = url;
    a.download = `fintrack_${startYM}_ถึง_${endYM}.xls`;
    a.click();
    toast('ดาวน์โหลดไฟล์ Excel สำเร็จ ✓');
  } else {
    toast('กำลังสร้างไฟล์ PDF กรุณารอสักครู่...');
    // สร้างตารางเฉพาะกิจสำหรับพิมพ์ PDF ช่วงเวลานี้
    const tempDiv = document.createElement('div');
    tempDiv.style.padding = '20px';
    tempDiv.style.background = '#ffffff';
    tempDiv.style.color = '#000000';
    tempDiv.innerHTML = `
      <h2 style="margin-bottom:6px;">FinTrack Cloud - รายงานรายรับรายจ่าย</h2>
      <p style="margin-bottom:14px;color:#555;">ช่วงเวลา: ${startYM} ถึง ${endYM}</p>
      <table style="width:100%;border-collapse:collapse;font-size:12px;">
        <thead>
          <tr style="background:#7c8cff;color:#fff;">
            <th style="padding:8px;border:1px solid #ccc;">วันที่</th>
            <th style="padding:8px;border:1px solid #ccc;">ประเภท</th>
            <th style="padding:8px;border:1px solid #ccc;">หมวดหมู่</th>
            <th style="padding:8px;border:1px solid #ccc;">รายละเอียด</th>
            <th style="padding:8px;border:1px solid #ccc;text-align:right;">จำนวนเงิน</th>
          </tr>
        </thead>
        <tbody>
          ${filtered.map(t=>`
            <tr>
              <td style="padding:6px;border:1px solid #ccc;">${thDate(parseD(t.date))}</td>
              <td style="padding:6px;border:1px solid #ccc;">${t.type==='income'?'รายรับ':'รายจ่าย'}</td>
              <td style="padding:6px;border:1px solid #ccc;">${t.category}</td>
              <td style="padding:6px;border:1px solid #ccc;">${t.note||'-'}</td>
              <td style="padding:6px;border:1px solid #ccc;text-align:right;">${Number(t.amount).toLocaleString('th-TH',{minimumFractionDigits:2})}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
    
    const opt = {
      margin:       10,
      filename:     `fintrack_${startYM}_ถึง_${endYM}.pdf`,
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
    };

    html2pdf().from(tempDiv).set(opt).save().then(() => {
      toast('ดาวน์โหลดไฟล์ PDF สำเร็จ ✓');
    }).catch(err => {
      toast('เกิดข้อผิดพลาดในการสร้าง PDF', true);
    });
  }
}

/* ============ CATEGORY MODAL LOGIC ============ */
document.getElementById('manageCatBtn').onclick = () => {
  setCatModalType(TYPE);
  document.getElementById('catModal').classList.add('on');
};

function closeCatModal() {
  document.getElementById('catModal').classList.remove('on');
}

function setCatModalType(type) {
  catModalType = type;
  document.getElementById('mCatTabIn').style.background = type === 'income' ? 'var(--in)' : 'transparent';
  document.getElementById('mCatTabIn').style.color = type === 'income' ? '#04241c' : 'var(--muted)';
  document.getElementById('mCatTabEx').style.background = type === 'expense' ? 'var(--ex)' : 'transparent';
  document.getElementById('mCatTabEx').style.color = type === 'expense' ? '#3d0a13' : 'var(--muted)';
  renderCatModalList();
}

function renderCatModalList() {
  const list = CATS[catModalType] || [];
  const container = document.getElementById('catListContainer');
  if(list.length === 0) {
    container.innerHTML = '<div style="text-align:center;color:var(--muted);font-size:13px;padding:12px">ไม่มีหมวดหมู่</div>';
    return;
  }
  container.innerHTML = list.map(c => `
    <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 10px;border-bottom:1px solid var(--stroke);font-size:13px">
      <span>${c}</span>
      <button type="button" class="btn" style="padding:2px 8px;font-size:12px;color:var(--ex);border-color:rgba(255,107,129,.3)" onclick="deleteCategory('${catModalType}', '${c}')">ลบ</button>
    </div>
  `).join('');
}

async function addNewCategory() {
  const nameInput = document.getElementById('newCatName');
  const name = nameInput.value.trim();
  if(!name) return toast('กรุณากรอกชื่อหมวดหมู่', true);
  
  busy(true);
  try {
    const res = await call('addCat', { type: catModalType, name });
    CATS[catModalType].push(res.name);
    nameInput.value = '';
    renderCatModalList();
    catOpts();
    toast('เพิ่มหมวดหมู่สำเร็จ ✓');
  } catch(e) {
    toast(e.message, true);
  } finally {
    busy(false);
  }
}

async function deleteCategory(type, name) {
  if(!confirm(`ต้องการลบหมวดหมู่ "${name}" ใช่หรือไม่?`)) return;
  busy(true);
  try {
    await call('deleteCat', { type, name });
    CATS[type] = CATS[type].filter(c => c !== name);
    renderCatModalList();
    catOpts();
    toast('ลบหมวดหมู่เรียบร้อย');
  } catch(e) {
    toast(e.message, true);
  } finally {
    busy(false);
  }
}

/* ============ TOGGLE ESTIMATE VIEW ============ */
let isEstView = false;
document.getElementById('estBtn').onclick = () => {
  isEstView = !isEstView;
  document.getElementById('mainDashboardArea').hidden = isEstView;
  document.getElementById('estArea').hidden = !isEstView;
  document.getElementById('estBtn').style.background = isEstView ? 'rgba(124,140,255,.25)' : '';
  document.getElementById('estBtn').textContent = isEstView ? '📊 หน้าหลัก' : '📅 ประมาณการ';
  if(isEstView) {
    if(!document.getElementById('estMonthPicker').value) {
      const now = new Date();
      document.getElementById('estMonthPicker').value = now.getFullYear()+'-'+pad(now.getMonth()+1);
    }
    renderEstimateCalendar();
  }
};

/* ============ ESTIMATE CALENDAR LOGIC ============ */
function renderEstimateCalendar() {
  const ym = document.getElementById('estMonthPicker').value;
  if(!ym) return;
  const [year, month] = ym.split('-').map(Number);
  
  const firstDay = new Date(year, month - 1, 1).getDay();
  const totalDays = new Date(year, month, 0).getDate();

  let gridHTML = '';
  let sumIn = 0, sumEx = 0;

  for(let i=0; i<firstDay; i++) {
    gridHTML += `<div style="min-height:110px;background:var(--bg2);border:1px solid var(--stroke);border-radius:12px;opacity:0.2;"></div>`;
  }

  for(let day=1; day<=totalDays; day++) {
    const dayKey = `${ym}-${pad(day)}`;
    const items = ESTIMATES[dayKey] || [];
    
    let itemsHTML = '';
    items.forEach((item, idx) => {
      if(item.type === 'income') sumIn += Number(item.amount);
      else sumEx += Number(item.amount);

      const bg = item.type === 'income' ? 'rgba(34,211,166,.15)' : 'rgba(255,107,129,.15)';
      const color = item.type === 'income' ? 'var(--in)' : 'var(--ex)';
      const sign = item.type === 'income' ? '+' : '-';
      itemsHTML += `<div style="font-size:10.5px;background:${bg};color:${color};padding:2px 6px;border-radius:6px;margin-top:3px;display:flex;justify-content:space-between;align-items:center">
        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${sign} ${item.title}: ${Number(item.amount).toLocaleString()}</span>
        <span onclick="event.stopPropagation(); deleteEstimate('${dayKey}', ${idx})" style="cursor:pointer;font-weight:bold;margin-left:4px">×</span>
      </div>`;
    });

    gridHTML += `
      <div onclick="openModal('${dayKey}', ${day}, ${month}, ${year})" style="min-height:110px;background:var(--bg2);border:1px solid var(--stroke);border-radius:12px;padding:9px;cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:space-between;transition:.18s;" onmouseover="this.style.borderColor='var(--acc)'" onmouseout="this.style.borderColor='var(--stroke)'">
        <div style="font-weight:700;font-size:13px">${day}</div>
        <div style="overflow-y:auto;max-height:75px">${itemsHTML}</div>
      </div>
    `;
  }

  document.getElementById('estCalendarGrid').innerHTML = gridHTML;
  document.getElementById('estTotalIn').textContent = fmt(sumIn);
  document.getElementById('estTotalEx').textContent = fmt(sumEx);
  const net = sumIn - sumEx;
  const netEl = document.getElementById('estNet');
  netEl.textContent = fmt(net);
  netEl.style.color = net >= 0 ? css('--in') : css('--ex');
}

function openModal(dayKey, day, month, year) {
  document.getElementById('modalDayKey').value = dayKey;
  document.getElementById('modalDateTitle').textContent = `วันที่ ${day} ${TH_M[month-1]} ${year+543}`;
  document.getElementById('mTitle').value = '';
  document.getElementById('mAmount').value = '';
  setModalType('income');
  document.getElementById('estModal').classList.add('on');
}

function closeModal() {
  document.getElementById('estModal').classList.remove('on');
}

function setModalType(type) {
  modalType = type;
  document.getElementById('mTypeIn').className = type === 'income' ? 'on-in' : '';
  document.getElementById('mTypeEx').className = type === 'expense' ? 'on-ex' : '';
}

function saveEstimateItem(e) {
  e.preventDefault();
  const dayKey = document.getElementById('modalDayKey').value;
  const title = document.getElementById('mTitle').value.trim();
  const amount = parseFloat(document.getElementById('mAmount').value);
  
  if(!title || isNaN(amount)) return;

  if(!ESTIMATES[dayKey]) ESTIMATES[dayKey] = [];
  ESTIMATES[dayKey].push({ type: modalType, title, amount });
  
  localStorage.setItem('ftc_estimates', JSON.stringify(ESTIMATES));
  closeModal();
  renderEstimateCalendar();
  toast('บันทึกประมาณการเรียบร้อย ✓');
}

function deleteEstimate(dayKey, index) {
  ESTIMATES[dayKey].splice(index, 1);
  if(ESTIMATES[dayKey].length === 0) delete ESTIMATES[dayKey];
  localStorage.setItem('ftc_estimates', JSON.stringify(ESTIMATES));
  renderEstimateCalendar();
  toast('ลบเรียบร้อย');
}

/* ============ BOOTSTRAP ============ */
async function enterApp(){
  const d = await call('bootstrap');
  ME=d.user; TX=d.tx; CATS=d.cats;
  document.getElementById('authView').style.display = 'none';
  document.getElementById('appView').hidden=false;
  document.getElementById('userTxt').textContent=ME.displayName;
  document.getElementById('avatar').textContent=(ME.displayName||'U').trim().charAt(0).toUpperCase();
  document.getElementById('todayTxt').textContent='วันนี้ '+thDate(new Date());
  const now=new Date(), iw=isoWeek(now);
  document.getElementById('pWeek').value=iw.year+'-W'+pad(iw.week);
  document.getElementById('pMonth').value=now.getFullYear()+'-'+pad(now.getMonth()+1);
  document.getElementById('fDate').value=toStr(now);
  fillYears(); setType('income'); render();
}
function fillYears(){
  const s = document.getElementById('pYear'), cur = s.value;
  const ys = new Set(TX.map(t => +t.date.slice(0,4)));
  const currentYear = new Date().getFullYear();
  ys.add(currentYear);
  for(let y = currentYear; y <= 2036; y++) {
    ys.add(y);
  }
  s.innerHTML = [...ys].sort((a,b)=>b-a).map(y => '<option value="'+y+'">ปี '+(y+543)+' ('+y+')</option>').join('');
  s.value = cur && [...ys].includes(+cur) ? cur : currentYear;
}

/* ============ PERIOD ============ */
function period(){
  if(MODE==='week'){const[y,w]=document.getElementById('pWeek').value.split('-W').map(Number);
    const[s,e]=weekRange(y,w);return{s,e,year:y,label:'สัปดาห์ที่ '+w+'/'+y,range:thDate(s)+' – '+thDate(e)};}
  if(MODE==='month'){const[y,m]=document.getElementById('pMonth').value.split('-').map(Number);
    const s=new Date(y,m-1,1),e=new Date(y,m,0);return{s,e,year:y,label:TH_M[m-1]+' '+(y+543),range:thDate(s)+' – '+thDate(e)};}
  const y=+document.getElementById('pYear').value;
  return{s:new Date(y,0,1),e:new Date(y,11,31),year:y,label:'ปี '+(y+543),range:'1 ม.ค. – 31 ธ.ค. '+(y+543)};
}
function buckets(list){
  let labels,idx;
  if(MODE==='week'){labels=['จันทร์','อังคาร','พุธ','พฤหัส','ศุกร์','เสาร์','อาทิตย์'];idx=d=>(d.getDay()+6)%7;}
  else if(MODE==='month'){labels=['1-7','8-14','15-21','22-28','29-31'];idx=d=>Math.min(Math.floor((d.getDate()-1)/7),4);}
  else{labels=TH_M.slice();idx=d=>d.getMonth();}
  const I=Array(labels.length).fill(0),E=Array(labels.length).fill(0);
  list.forEach(t=>{const i=idx(parseD(t.date));(t.type==='income'?I:E)[i]+=t.amount;});
  let run=0;const N=I.map((v,i)=>run+=v-E[i]);return{labels,I,E,N};
}
const byCat=(l,ty)=>{const m={};l.filter(t=>t.type===ty).forEach(t=>m[t.category]=(m[t.category]||0)+t.amount);
  return Object.entries(m).sort((a,b)=>b[1]-a[1]);};

/* ============ CHARTS ============ */
let C1,C2,C3,C4;
Chart.defaults.font.family="'IBM Plex Sans Thai',sans-serif";
function drawCharts(p,list){
  const b=buckets(list),tc=css('--txt'),mc=css('--muted');
  [C1,C2,C3,C4].forEach(c=>c&&c.destroy());
  C1=new Chart(document.getElementById('chMain'),{data:{labels:b.labels,datasets:[
    {type:'bar',label:'รายรับ',data:b.I,backgroundColor:'rgba(34,211,166,.85)',borderRadius:7,maxBarThickness:34},
    {type:'bar',label:'รายจ่าย',data:b.E,backgroundColor:'rgba(255,107,129,.85)',borderRadius:7,maxBarThickness:34},
    {type:'line',label:'คงเหลือสะสม',data:b.N,borderColor:css('--acc'),backgroundColor:'rgba(124,140,255,.12)',fill:true,tension:.38,borderWidth:2.5,pointRadius:3}]},
    options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},
      plugins:{legend:{labels:{color:tc,usePointStyle:true,boxWidth:8,padding:16}},
      tooltip:{callbacks:{label:c=>' '+c.dataset.label+': '+fmt(c.raw)}}},
      scales:{x:{ticks:{color:mc},grid:{display:false}},y:{ticks:{color:mc,callback:v=>fmtS(v)},grid:{color:gridC()}}}}});

  const yl=TX.filter(t=>+t.date.slice(0,4)===p.year);
  const ym=Array.from({length:12},(_,i)=>({i:yl.filter(t=>t.type==='income'&&parseD(t.date).getMonth()===i).reduce((s,t)=>s+t.amount,0),
                                           e:yl.filter(t=>t.type==='expense'&&parseD(t.date).getMonth()===i).reduce((s,t)=>s+t.amount,0)}));
  C4=new Chart(document.getElementById('chYear'),{type:'bar',data:{labels:TH_M,datasets:[
    {label:'รายรับ',data:ym.map(x=>x.i),backgroundColor:'rgba(34,211,166,.8)',borderRadius:4,maxBarThickness:14},
    {label:'รายจ่าย',data:ym.map(x=>x.e),backgroundColor:'rgba(255,107,129,.8)',borderRadius:4,maxBarThickness:14}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},
      tooltip:{callbacks:{label:c=>' '+c.dataset.label+': '+fmt(c.raw)}}},
      scales:{x:{ticks:{color:mc,font:{size:10}},grid:{display:false}},
              y:{ticks:{color:mc,font:{size:10},callback:v=>fmtS(v)},grid:{color:gridC()}}}}});

  const donut=(el,data,pal)=>new Chart(el,{type:'doughnut',
    data:{labels:data.length?data.map(d=>d[0]):['ไม่มีข้อมูล'],
      datasets:[{data:data.length?data.map(d=>d[1]):[1],backgroundColor:data.length?pal:['rgba(147,160,196,.25)'],borderWidth:0,hoverOffset:10}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'62%',
      plugins:{legend:{position:'right',labels:{color:tc,usePointStyle:true,boxWidth:8,padding:11,font:{size:11.5}}},
      tooltip:{callbacks:{label:c=>data.length?' '+c.label+': '+fmt(c.raw):' ไม่มีข้อมูล'}}}}});
  C2=donut(document.getElementById('chExCat'),byCat(list,'expense'),['#ff6b81','#ff9f7f','#ffd166','#b06bff','#7c8cff','#4cc9f0','#f472b6','#94a3b8','#f97316','#22d3a6']);
  C3=donut(document.getElementById('chInCat'),byCat(list,'income'),['#22d3a6','#4cc9f0','#7c8cff','#b06bff','#5eead4','#a3e635']);
}

/* ============ RENDER ============ */
function render(){
  const p=period(),list=TX.filter(t=>{const d=parseD(t.date);return d>=p.s&&d<=p.e;})
    .sort((a,b)=>b.date.localeCompare(a.date));
  document.getElementById('rangeTxt').textContent='📅 '+p.label+'  ·  '+p.range;
  document.getElementById('cmpTitle').textContent='เปรียบเทียบรายรับ–รายจ่าย · '+p.label;

  const I=list.filter(t=>t.type==='income').reduce((s,t)=>s+t.amount,0);
  const E=list.filter(t=>t.type==='expense').reduce((s,t)=>s+t.amount,0);
  const N=I-E, r=I>0?N/I*100:0;
  document.getElementById('kIn').textContent=fmt(I);
  document.getElementById('kEx').textContent=fmt(E);
  document.getElementById('kNet').textContent=fmt(N);
  document.getElementById('kNet').style.color=N>=0?css('--in'):css('--ex');
  document.getElementById('kInF').textContent=list.filter(t=>t.type==='income').length+' รายการ';
  document.getElementById('kExF').textContent=list.filter(t=>t.type==='expense').length+' รายการ';
  document.getElementById('kNetF').textContent=N>=0?'✅ เหลือเก็บ':'⚠️ ใช้เกินรายรับ';
  document.getElementById('kRate').textContent=r.toFixed(1)+'%';
  document.getElementById('kRate').style.color=r>=20?css('--in'):r>=0?css('--acc2'):css('--ex');

  const yl=TX.filter(t=>+t.date.slice(0,4)===p.year);
  const yI=yl.filter(t=>t.type==='income').reduce((s,t)=>s+t.amount,0);
  const yE=yl.filter(t=>t.type==='expense').reduce((s,t)=>s+t.amount,0);
  const mx=Math.max(yI,yE,1);
  document.getElementById('yLabel').textContent=p.year+543;
  document.getElementById('yIn').textContent=fmt(yI);
  document.getElementById('yEx').textContent=fmt(yE);
  document.getElementById('yNet').textContent=fmt(yI-yE);
  document.getElementById('yNet').style.color=yI-yE>=0?css('--in'):css('--ex');
  document.getElementById('yInBar').style.width=(yI/mx*100)+'%';
  document.getElementById('yExBar').style.width=(yE/mx*100)+'%';
  document.getElementById('yNetBar').style.width=(Math.abs(yI-yE)/mx*100)+'%';

  drawCharts(p,list);

  const q=document.getElementById('q').value.trim().toLowerCase(),ft=document.getElementById('fType').value;
  const rows=list.filter(t=>(ft==='all'||t.type===ft)&&(!q||(t.category+' '+(t.note||'')).toLowerCase().includes(q)));
  document.getElementById('cnt').textContent='('+rows.length+' รายการ)';
  document.getElementById('emptyBox').hidden=rows.length>0;
  document.getElementById('tbody').innerHTML=rows.map(t=>'<tr>'+
    '<td style="white-space:nowrap">'+thDate(parseD(t.date))+'</td>'+
    '<td><span class="pill '+(t.type==='income'?'in':'ex')+'">'+(t.type==='income'?'รายรับ':'รายจ่าย')+'</span></td>'+
    '<td>'+t.category+'</td><td style="color:var(--muted)">'+(t.note||'—')+'</td>'+
    '<td class="amt" style="color:'+(t.type==='income'?css('--in'):css('--ex'))+'">'+(t.type==='income'?'+':'−')+fmt(t.amount)+'</td>'+
    '<td><button class="ic" onclick="editTx(\''+t.id+'\')">✏️</button> <button class="ic" onclick="delTx(\''+t.id+'\')">🗑</button></td></tr>').join('');
}

/* ============ CRUD ============ */
function catOpts(){document.getElementById('fCat').innerHTML=(CATS[TYPE]||[]).map(c=>'<option>'+c+'</option>').join('');}
function setType(t){TYPE=t;document.getElementById('bIn').className=t==='income'?'on-in':'';
  document.getElementById('bEx').className=t==='expense'?'on-ex':'';catOpts();}
document.getElementById('bIn').onclick=()=>setType('income');
document.getElementById('bEx').onclick=()=>setType('expense');

document.getElementById('txForm').onsubmit=async e=>{e.preventDefault();
  const payload={type:TYPE,date:document.getElementById('fDate').value,category:document.getElementById('fCat').value,
    note:document.getElementById('fNote').value,amount:document.getElementById('fAmt').value};
  busy(true);
  try{
    if(EDIT){payload.id=EDIT;const d=await call('updateTx',payload);TX=TX.map(t=>t.id===EDIT?d:t);toast('แก้ไขแล้ว ✓');}
    else{const d=await call('addTx',payload);TX.push(d);toast('บันทึกลง Google Sheets แล้ว ✓');}
    EDIT=null;fillYears();resetForm();render();
  }catch(err){toast(err.message,true);}finally{busy(false);}};

function resetForm(){document.getElementById('txForm').reset();EDIT=null;
  document.getElementById('fDate').value=toStr(new Date());
  document.getElementById('formTitle').textContent='➕ เพิ่มรายการใหม่';
  document.getElementById('cancelEdit').hidden=true;setType(TYPE);}
document.getElementById('cancelEdit').onclick=resetForm;

window.editTx=id=>{const t=TX.find(x=>x.id===id);if(!t)return;EDIT=id;setType(t.type);
  document.getElementById('fDate').value=t.date;document.getElementById('fCat').value=t.category;
  document.getElementById('fNote').value=t.note||'';document.getElementById('fAmt').value=t.amount;
  document.getElementById('formTitle').textContent='✏️ แก้ไขรายการ';
  document.getElementById('cancelEdit').hidden=false;
  document.getElementById('txForm').scrollIntoView({behavior:'smooth',block:'center'});};

window.delTx=async id=>{
  busy(true);
  try{await call('deleteTx',{id:id});TX=TX.filter(t=>t.id!==id);fillYears();render();toast('ลบเรียบร้อย');}
  catch(e){toast(e.message,true);}finally{busy(false);}};

/* ============ TOOLS ============ */
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');MODE=b.dataset.mode;
  document.getElementById('pWeek').hidden=MODE!=='week';document.getElementById('pMonth').hidden=MODE!=='month';
  document.getElementById('pYear').hidden=MODE!=='year';render();});
['pWeek','pMonth','pYear','q','fType'].forEach(id=>document.getElementById(id).oninput=render);

document.getElementById('syncBtn').onclick=async()=>{busy(true);
  try{const d=await call('bootstrap');TX=d.tx;CATS=d.cats;fillYears();catOpts();render();toast('ซิงก์ข้อมูลล่าสุดแล้ว ✓');}
  catch(e){toast(e.message,true);}finally{busy(false);}};

document.getElementById('themeBtn').onclick=()=>{const h=document.documentElement;
  h.dataset.theme=h.dataset.theme==='dark'?'light':'dark';store('ftc_theme',h.dataset.theme);render();};
try{ if(localStorage.getItem('ftc_theme')) document.documentElement.dataset.theme=localStorage.getItem('ftc_theme'); }catch(e){}

/* ============ INIT ============ */
(async function(){
  if(!TOKEN) return;
  busy(true);
  try{ await enterApp(); }
  catch(e){ TOKEN=''; store('ftc_token',null); }
  finally{ busy(false); }
})();
</script>
